rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Emails autorizados para CREAR eventos ────────────────────────────────
    function isAllowed() {
      return request.auth != null && request.auth.token.email in [
        // Añade aquí los emails autorizados para crear eventos:
        'tu_email@gmail.com'
      ];
    }

    // ─── Admin de un evento concreto ──────────────────────────────────────────
    // Acepta el ownerId original (backwards compat) o cualquier email en admins[]
    function isEventAdmin(eventData) {
      return request.auth != null && (
        request.auth.uid == eventData.ownerId ||
        (eventData.admins is list && request.auth.token.email in eventData.admins)
      );
    }

    match /events/{eventId} {
      // Lectura por ID (espectadores, pantalla TV): siempre permitida
      allow get: if true;
      // Queries: solo usuarios autenticados (los filtros del cliente garantizan que
      // solo piden sus propios eventos; update/delete sigue protegido por isEventAdmin)
      allow list: if request.auth != null;
      allow create: if isAllowed();
      allow update, delete: if isEventAdmin(resource.data);

      match /participants/{participantId} {
        allow read: if true;
        allow write: if isEventAdmin(
          get(/databases/$(database)/documents/events/$(eventId)).data
        );
      }

      match /votes/{userId} {
        allow read: if true;
        allow write: if true;  // espectadores anónimos con UUID local
      }
    }

    match /artists/{artistId} {
      allow read: if true;
      allow write, delete: if isAllowed();
    }

    match /otps/{code} {
      allow read, delete: if true;   // la pantalla lee y destruye sin auth
      allow create: if request.auth != null; // solo admin logueado genera
    }
  }
}
